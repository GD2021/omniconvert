{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omniconvert",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "omniconvert.lucky.cloudns.biz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
